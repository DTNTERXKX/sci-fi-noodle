OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Optional. Empty uses the default ElevenLabs voice
ELEVENLABS_VOICE_ID=
# Optional. Local MuseTalk live lip-sync sidecar. Empty uses http://127.0.0.1:8788
