<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- Skip the default-document rewrite when this section is unlocked. If IIS still
           remaps /, the app serves the shell anyway and names the path it got in X-SFN-Path. -->
      <defaultDocument enabled="false" />
      <!-- Rewrite rules inherited from the Plesk site config 404 the homepage; Kestrel routes everything.
           Needs the IIS URL Rewrite module: if the site shows 500.19, delete this block. -->
      <rewrite>
        <rules>
          <clear />
        </rules>
        <outboundRules>
          <clear />
        </outboundRules>
      </rewrite>
    </system.webServer>
  </location>
</configuration>
