<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SciFiNoodles.Web</RootNamespace>
    <AssemblyName>SciFiNoodles.Web</AssemblyName>
    <!-- Plesk leaves the site pool on the .NET Framework CLR. In-process hosting then fails to load inside w3wp. Out-of-process starts dotnet.exe for this folder. -->
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
    <EnvironmentName>Production</EnvironmentName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\app\data\katara.sqlite" Link="Data\katara.sqlite" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Data\sitemap-paths.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ANCM only writes stdout under this path, and only if the directory already exists. -->
  <Target Name="CreatePublishLogsDirectory" AfterTargets="Publish">
    <MakeDir Directories="$([System.IO.Path]::Combine('$(PublishDir)', 'logs'))" />
  </Target>

</Project>
