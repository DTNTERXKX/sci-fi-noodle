# Public site URL (production: https://bbellweb.info)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres (Neon) — required for Phase 1+
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Stripe (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Recurring Price IDs (Products → each plan → Price ID)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_AGENCY=price_...
STRIPE_PRICE_DFY=price_...

# OpenAI (Site Studio generation)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Signs subscription session cookies (random 32+ chars)
SESSION_SECRET=change-me-to-a-long-random-string

# Stripe webhook (Dashboard → Webhooks → your production URL)
# https://bbellweb.info/api/stripe/webhook
